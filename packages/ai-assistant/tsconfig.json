    },
    {
      "path": "../codeeditor"
    },
    {
      "path": "../codemirror"
    },
    {
      "path": "../coreutils"
    },
    {
      "path": "../docregistry"
    },
    {
      "path": "../notebook"
    },
    {
      "path": "../rendermime"
    },
    {
      "path": "../services"
    },
    {
      "path": "../settingregistry"
    },
    {
      "path": "../statedb"
    },
    {
      "path": "../ui-components"
    }
